{
  "model_version": "M4-v1.0",
  "model_type": "RandomForestClassifier + sigmoid probability calibration",
  "target": "landslide_synthetic_label",
  "features": [
    "slope_deg",
    "elevation_m",
    "land_cover_code",
    "geology_code",
    "rainfall_1h",
    "rainfall_3h",
    "rainfall_6h",
    "rainfall_12h",
    "rainfall_24h",
    "soil_moisture",
    "moisture_change_3h"
  ],
  "categorical_encodings": {
    "land_cover": {
      "urban": 0,
      "cropland": 1,
      "forest": 2,
      "sparse_vegetation": 3
    },
    "geology": {
      "unconsolidated_sediment": 0,
      "sedimentary": 1,
      "fractured_metamorphic": 2
    }
  },
  "risk_thresholds": {
    "LOW": "<0.30",
    "MODERATE": "0.30-<0.60",
    "HIGH": "0.60-<0.80",
    "EXTREME": ">=0.80"
  },
  "validation_selected_threshold": 0.5132525262294174,
  "random_seed": 42,
  "data_is_synthetic": true,
  "label_is_synthetic": true,
  "label_rule": {
    "description": "landslide_synthetic_label = 1 if a weighted combination of normalized slope, soil moisture, 24h rainfall, and a land_cover/geology terrain-risk factor (see landslide_risk_score() in train_landslide.py), plus Gaussian noise, is >= threshold. Not derived from any real landslide event data.",
    "weights": {
      "slope": 0.35,
      "moisture": 0.3,
      "rainfall": 0.2,
      "terrain": 0.2
    },
    "slope_norm_deg": 45.0,
    "moisture_norm_pct": 100.0,
    "rainfall_24h_norm_mm": 150.0,
    "noise_sigma": 0.05,
    "label_threshold": 0.55,
    "land_cover_risk_weights": {
      "forest": 0.3,
      "urban": 0.5,
      "cropland": 0.7,
      "sparse_vegetation": 1.0
    },
    "geology_risk_weights": {
      "sedimentary": 0.5,
      "fractured_metamorphic": 0.8,
      "unconsolidated_sediment": 1.0
    }
  },
  "terrain_assignment_rule": "land_cover/geology are derived deterministically per station from that station's own slope_deg/elevation_m via assign_terrain() in train_landslide.py \u2014 a stand-in for a real GIS land-cover/geology lookup, which this prototype does not have.",
  "splits": {
    "train_rows": 8400,
    "validation_rows": 1800,
    "test_rows": 1800
  },
  "metrics": {
    "train": {
      "threshold": 0.5132525262294174,
      "accuracy": 0.9794047619047619,
